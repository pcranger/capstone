# Used by app.config.ts. Never put real credentials in this example or commit .env.
GOOGLE_MAP_API_KEY=
GEMINI_API_KEY=
# Optional overrides when native SDK and REST restrictions require separate keys.
GOOGLE_MAPS_IOS_API_KEY=
GOOGLE_MAPS_ANDROID_API_KEY=
# The Android Maps key is read from the environment or this .env at Gradle build time
# (android/app/build.gradle). Never write it into android/; the manifest holds only ${googleMapsApiKey}.
GOOGLE_MAPS_REST_API_KEY=
