{
  "name": "crosswise",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@types/jest": "29.5.14",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.24",
    "expo-asset": "~57.0.18",
    "expo-battery": "~57.0.3",
    "expo-build-properties": "~57.0.21",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-keep-awake": "~57.0.2",
    "expo-linear-gradient": "~57.0.2",
    "expo-location": "~57.0.19",
    "expo-sensors": "~57.0.3",
    "expo-sharing": "~57.0.21",
    "expo-speech": "~57.0.3",
    "expo-speech-recognition": "57.1.0",
    "expo-status-bar": "~57.0.1",
    "fflate": "^0.8.3",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "jsfeat": "^0.0.8",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-audio-api": "^0.13.6",
    "react-native-fast-tflite": "^3.0.1",
    "react-native-maps": "1.27.2",
    "react-native-nitro-image": "^0.15.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-vision-camera": "^5.2.3",
    "react-native-vision-camera-resizer": "^5.2.3",
    "react-native-vision-camera-worklets": "^5.2.3",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "android": "expo run:android",
    "android:preview": "node scripts/build-android-preview.cjs",
    "postinstall": "node scripts/patch-tflite-lifetime.cjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ]
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-fast-tflite"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
